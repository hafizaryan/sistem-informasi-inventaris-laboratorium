#--------------------------------------------------------------------
# SITARIS - contoh konfigurasi environment
# Salin menjadi .env lalu sesuaikan. JANGAN commit berkas .env.
#--------------------------------------------------------------------

# development | production
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Asia/Jakarta'

#--------------------------------------------------------------------
# DATABASE (lokal)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = sitaris
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# MODE DEMO
# Aktif HANYA jika CI_ENVIRONMENT=development DAN sitaris.demoMode=true.
# Di production nilai ini diabaikan.
#--------------------------------------------------------------------
sitaris.demoMode = false

# Kata sandi akun demo untuk `php spark db:seed DemoUserSeeder`.
# Pilih sendiri; seeder menolak nilai kosong. Jangan pakai kata sandi yang Anda pakai di tempat lain.
sitaris.demoPassword =
